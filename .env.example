# --- Required: session signing key (any random 64-byte string) ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- Vercel KV (auto-populated when you connect the KV store to the project) ---
# DO NOT fill manually. Run: vercel env pull .env.development.local
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
